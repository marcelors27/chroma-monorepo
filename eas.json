{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_PIX": "true",
        "EXPO_PUBLIC_PIX_PROVIDER": "manual"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_PIX": "true",
        "EXPO_PUBLIC_PIX_PROVIDER": "manual"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_ENABLE_PIX": "true",
        "EXPO_PUBLIC_PIX_PROVIDER": "manual"
      }
    }
  }
}
