{
  "expo": {
    "name": "Chroma Mobile Store",
    "slug": "chroma-mobile-front-v2",
    "scheme": "chroma-mobile",
    "version": "0.2.39",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.chroma.mobilestore",
      "googleServicesFile": "../../keys/mobile-front-v2/google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.chroma.mobilestore",
      "buildNumber": "49",
      "appleTeamId": "BMZ7XQ54J3",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Usamos a camera para permitir que voce tire fotos para o seu perfil e envio de conteudos no app.",
        "NSUserTrackingUsageDescription": "Usamos este identificador para habilitar login com Facebook e melhorar a seguranca da autenticacao.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "scopes": [
            "profile",
            "email"
          ],
          "iosUrlScheme": "com.googleusercontent.apps.633351241832-2t9hj3ptto4pdrk5akbmsi2f7otb2k9b"
        }
      ]
    ],
    "owner": "marcelors27",
    "extra": {
      "eas": {
        "projectId": "bc274720-bc11-4e33-8dfe-7090b339aba4"
      }
    }
  }
}
