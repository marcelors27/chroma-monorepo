{
  "expo": {
    "name": "Chroma Mobile Store",
    "slug": "chroma-mobile-front-v2",
    "scheme": "chroma-mobile",
    "version": "0.2.11",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "statusBar": {
      "style": "light",
      "backgroundColor": "#000000"
    },
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.chroma.mobilestore",
      "googleServicesFile": "google-services.json",
      "statusBar": {
        "barStyle": "light-content",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "bundleIdentifier": "com.chroma.mobilestore",
      "buildNumber": "12",
      "appleTeamId": "BMZ7XQ54J3",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "scopes": [
            "profile",
            "email"
          ],
          "iosUrlScheme": "com.googleusercontent.apps.633351241832-2t9hj3ptto4pdrk5akbmsi2f7otb2k9b"
        }
      ]
    ],
    "owner": "marcelors27",
    "extra": {
      "eas": {
        "projectId": "bc274720-bc11-4e33-8dfe-7090b339aba4"
      }
    }
  }
}
